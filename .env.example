# Linux 실습실 환경 설정
# cp .env.example .env 후 편집

# 웹 UI 도메인 (Caddy가 자동으로 TLS 발급)
# ENABLE_CADDY=0 이면 비워도 됩니다.
DOMAIN="linux.example.com"

# 호스트 외부 NIC 이름 (ip a 로 확인)
# ENABLE_PUBLIC_IPS=0 이면 비워도 됩니다.
HOST_IFACE="enp0s6"

# 웹앱을 실행할 서버 사용자
INSTALL_USER="ubuntu"

# 컨테이너 런타임: lxd (기본, snap 필요) 또는 incus
# incus 사용 시 기본값이 incusbr0 / images:ubuntu/noble / incus-admin 로 바뀝니다.
# (Zabbly apt 저장소에서 설치하며 snapd가 필요 없습니다)
CONTAINER_RUNTIME="lxd"

# 컨테이너 수 (1~100)
CONTAINER_COUNT="10"

# 컨테이너 내부 IP 시작 옥텟 (10.10.0.{OFFSET} ~ 10.10.0.{OFFSET+COUNT-1})
# 예: OFFSET=10, COUNT=10 → 10.10.0.10 ~ 10.10.0.19
CONTAINER_IP_OFFSET="10"

# LXD 브리지 IP / 서브넷 (기본값 권장)
# 호스트가 사용하는 대역과 겹치지 않아야 합니다.
LXD_BRIDGE_IP="10.10.0.1"
LXD_BRIDGE_SUBNET="10.10.0.0/24"

# 컨테이너 IP 앞 3옥텟 (미설정 시 LXD_BRIDGE_IP에서 자동 유도)
CONTAINER_IP_PREFIX="10.10.0"

# 컨테이너당 메모리 제한 / swap 허용
# CONTAINER_SWAP:
#   - true  : 메모리 제한과 같은 크기의 swap 허용 (false면 금지)
#   - Incus에서만 바이트 값(예: "2GiB")도 허용됩니다.
#     cgroup2 + 하드 메모리 제한에서는 boolean true가 swap 0이 되므로
#     스크립트가 true를 CONTAINER_MEMORY 크기로 자동 변환합니다.
#   - LXD는 이 키를 bool로만 검증하므로 true/false만 사용하세요.
CONTAINER_MEMORY="1536MB"
CONTAINER_SWAP="true"

# 컨테이너 생성 시 추가로 설치할 패키지 (공백 구분, 비우면 미설치)
CONTAINER_EXTRA_PACKAGES="wget nano man-db tree net-tools traceroute dnsutils git htop tmux unzip openssh-server openssh-client"

# 컨테이너 SSH 서버 활성화 여부 (1=활성, 0=비활성(기본))
# openssh-server는 설치되지만 기본적으로 ssh.socket/ssh.service를 비활성화합니다.
CONTAINER_SSH_ENABLED="0"

# 웹앱 바인딩 주소 (Caddy 없이 직접 노출하려면 0.0.0.0)
BIND_ADDRESS="127.0.0.1"

# 공인/Secondary IP 기반 외부 접속 사용 여부 (1=사용, 0=웹 터미널만)
ENABLE_PUBLIC_IPS="1"

# Caddy 리버스 프록시 + TLS 사용 여부 (1=사용, 0=미사용)
ENABLE_CADDY="1"

# Secondary Private IP 목록 (클라우드 콘솔에서 할당한 내부 IP)
# ENABLE_PUBLIC_IPS=1 이면 CONTAINER_COUNT와 개수가 반드시 일치해야 합니다
SECONDARY_IPS=(
  "10.0.10.100"
  "10.0.10.101"
  "10.0.10.102"
  "10.0.10.103"
  "10.0.10.104"
  "10.0.10.105"
  "10.0.10.106"
  "10.0.10.107"
  "10.0.10.108"
  "10.0.10.109"
)
